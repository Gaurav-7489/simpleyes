# Canonical production URL (no trailing slash). Used for canonical links,
# sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://simplyes.de

# Business WhatsApp number in international format, digits only (no +, spaces).
# Default (if unset) is the number published on the current simplyes.de site.
NEXT_PUBLIC_WHATSAPP_NUMBER=4915216627596

# Set to "production" ONLY for the live simplyes.de build. Any other value
# (or unset on Vercel previews) makes the build emit `noindex` and a
# disallow-all robots.txt so previews/staging never get indexed.
# On Vercel, VERCEL_ENV is detected automatically.
NEXT_PUBLIC_SITE_ENV=production

# Enquiry form endpoint (approved form service; JSON POST, 2xx only when
# accepted). Recommended: Formdall, https://api.formdall.de/api/v1/f/<FORM_KEY>
# (see docs/ENQUIRY-SETUP.md). Unset = the form explains it is not connected
# yet and offers WhatsApp/email instead. Any other host must be added to
# connect-src/form-action in vercel.json's Content-Security-Policy.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Name of the form service's hidden anti-spam (honeypot) field, copied from the
# hidden input in Formdall's "Embed" snippet. Must match the service.
NEXT_PUBLIC_ENQUIRY_HONEYPOT_FIELD=

# Approved public contact / enquiry email (owner-supplied). Unset = hidden.
NEXT_PUBLIC_CONTACT_EMAIL=Info@simplyes.de

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Unset = no analytics, no banner.
NEXT_PUBLIC_GA_ID=
